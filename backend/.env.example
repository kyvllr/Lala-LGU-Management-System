# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/lgufiling_db?retryWrites=true&w=majority

# JWT Secret (change in production)
JWT_SECRET=your-secret-key-change-in-production

# Server Port
PORT=5001


# Environment
NODE_ENV=development

# Optional: bootstrap one default account at startup (development only)
ENABLE_DEFAULT_CREDENTIALS=false
DEFAULT_CREDENTIALS_STAFF_ID=HADMIN001
DEFAULT_CREDENTIALS_NAME=HR Administrator
DEFAULT_CREDENTIALS_EMAIL=admin@lgu.gov
DEFAULT_CREDENTIALS_PASSWORD=<set-a-strong-password>
DEFAULT_CREDENTIALS_ROLE=admin_hr
DEFAULT_CREDENTIALS_POSITION=HR Administrator
DEFAULT_CREDENTIALS_DEPARTMENT=
